{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": false
  },
  "include": ["docs/.vitepress/**/*.ts", "docs/.vitepress/**/*.mts", "docs/**/*.data.ts"],
  "exclude": ["docs/.vitepress/samples.d.ts"]
}
